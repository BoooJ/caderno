{"data": [{"id": 9535584, "text": "Feliz Natal, Tatoeba!", "lang": "por", "script": null, "license": "CC BY 2.0 FR", "owner": "carlosalberto", "is_unapproved": false, "translations": [{"id": 3663323, "text": "Joyeux Noël, Tatoeba !", "lang": "fra", "script": null, "license": "CC BY 2.0 FR", "owner": "fleur74", "is_unapproved": false, "is_direct": true}]}, {"id": 6814073, "text": "Nós éramos felizes.", "lang": "por", "script": null, "license": "CC BY 2.0 FR", "owner": "Ricardo14", "is_unapproved": false, "translations": [{"id": 4601254, "text": "Nous étions heureux.", "lang": "fra", "script": null, "license": "CC BY 2.0 FR", "owner": "Amastan", "is_unapproved": false, "is_direct": true}]}, {"id": 4600639, "text": "Você parece feliz.", "lang": "por", "script": null, "license": "CC BY 2.0 FR", "owner": "KimiP", "is_unapproved": false, "translations": [{"id": 4602248, "text": "Vous avez l'air heureux.", "lang": "fra", "script": null, "license": "CC BY 2.0 FR", "owner": "sicerabibax", "is_unapproved": false, "is_direct": true}]}, {"id": 1236791, "text": "Vocês são felizes?", "lang": "por", "script": null, "license": "CC BY 2.0 FR", "owner": "alexmarcelo", "is_unapproved": false, "translations": [{"id": 685855, "text": "Êtes-vous heureux ?", "lang": "fra", "script": null, "license": "CC BY 2.0 FR", "owner": "sacredceltic", "is_unapproved": false, "is_direct": true}]}, {"id": 1236789, "text": "Vocês estão felizes?", "lang": "por", "script": null, "license": "CC BY 2.0 FR", "owner": "alexmarcelo", "is_unapproved": false, "translations": [{"id": 685855, "text": "Êtes-vous heureux ?", "lang": "fra", "script": null, "license": "CC BY 2.0 FR", "owner": "sacredceltic", "is_unapproved": false, "is_direct": true}]}], "paging": {"total": 172, "has_next": true, "next": "https://api.tatoeba.org/v1/sentences?lang=por&q=%22feliz%22&trans%3Alang=fra&trans%3Ais_direct=yes&is_unapproved=no&is_orphan=no&word_count=3-15&limit=5&sort=relevance&after=10097%2C1236789"}}